include LICENSE
include THIRD_PARTY_NOTICES.md
# setup.py reads it for long_description, and CI builds the wheel from the
# unpacked sdist, so a missing README breaks that build rather than the metadata.
include README.md
include LICENSES/*.txt
# The public materializer is standard-library-only and is required to build a
# wheel from an sdist. Family indexes, record shards, and Git-LFS packs are the
# only CUBIN artifact inputs that ship in source distributions.
# Keep every pattern non-recursive. Setuptools evaluates each recursive pattern
# as a separate ``**`` walk without consulting .gitignore, so editable metadata
# generation would otherwise descend into local CMake and CUBIN cache trees.
include cpp/CMakeLists.txt
include cpp/cmake/*.cmake
include cpp/cmake/*.py
include cpp/cmake/deps/*.cmake
include cpp/kernels/CMakeLists.txt
include cpp/kernels/*.cpp
include cpp/kernels/*.h
# The hand-written kernel directories the extension also compiles: the heuristic
# policy and the Claude Kit triangle attention. CMake names their sources
# explicitly, so a wheel built from the sdist fails at configure without them.
include cpp/kernels/heuristic/*.cpp
include cpp/kernels/heuristic/*.h
include cpp/kernels/claude_kit_*/*.cpp
include cpp/kernels/claude_kit_*/*.cu
include cpp/kernels/claude_kit_*/*.cuh
include cpp/kernels/claude_kit_*/*.h
include cpp/kernels/claude_kit_*/NOTICE.md
include cpp/kernels/cutedsl_*/*.cpp
include cpp/kernels/cutedsl_*/*.h
include cpp/kernels/cutedsl_*/cubins/index.json
include cpp/kernels/cutedsl_*/cubins/records/*.json
include cpp/kernels/cutedsl_*/cubins/packs/*.tar.xz
prune cpp/tools
exclude build.env
