{
    "version": "0.1.0",
    "pretrained_config": {
        "architecture": "pairformer",
        "dtype": "bfloat16",
        "logits_dtype": null,
        "norm_epsilon": 1e-05,
        "mask_inf": 1000000000.0,
        "skip_create_weights": false,
        "quant_algo": null,
        "disable_custom_all_reduce": true,
        "mapping": {
            "world_size": 1,
            "gpus_per_node": 8,
            "dcp_size": 1,
            "tp_size": 1,
            "pp_size": 1
        },
        "token_s": 384,
        "token_z": 128,
        "pairwise_head_width": 32,
        "pairwise_num_heads": 4,
        "num_blocks": 48,
        "num_heads": 16,
        "max_batch_size": 1,
        "max_transition_tp_size": true,
        "max_attention_pairwise_tp_size": true,
        "max_tri_mul_tp_size": true,
        "triangle_attn_node_chunk_size": 0,
        "no_update_s": false,
        "no_update_z": false,
        "backend": "torch",
        "triangle_attn_backend": "VANILLA",
        "pairwise_attn_backend": "VANILLA"
    }
}
