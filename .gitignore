# Per-developer opt-out of the CuTeDSL extension build; committing it would turn
# the extension off for every checkout.
build.env
# Keep only the authoritative public indexes and Git-LFS packs from CuTeDSL
# artifacts. Compiler caches and legacy/generated payloads remain local.
cpp/kernels/cutedsl_*/cubins/*
!cpp/kernels/cutedsl_*/cubins/index.json
!cpp/kernels/cutedsl_*/cubins/packs/
!cpp/kernels/cutedsl_*/cubins/packs/*.tar.xz
# Default output-root name used by setup.py and materializer diagnostics.
