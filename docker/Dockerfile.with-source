# syntax=docker/dockerfile:1
#
# stage graph is:
#
#         requirements_stage
#              └► copy_source_stage
#                      └► prod_stage  (FROM copy_source_stage)
#                      ├► dev_stage   (FROM copy_source_stage)
#
# The source-independent work (base image, pip upgrade) lives in the first stage
# so it stays cached across source edits; COPY . happens later so a code change
# only re-runs the copy + the package install below it.
#
# ------------------------------------------------------------------------
# requirements stage
#   - requirements change infrequently, slow download
# -------------------------------------------------------------------------
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch
ARG BASE_TAG=26.05-py3@sha256:222d8b18e671be5c3ef91cb41727a2572a0b23f59ded6c39f373a96946f6f2ba
FROM ${BASE_IMAGE}:${BASE_TAG} AS requirements_stage

ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${CUDA_HOME}/bin:${PATH}"

# The NGC PyTorch development image already provides PyTorch and a complete CUDA
# toolkit. nvcc is used by setup.py to stamp the CUDA local version (+cuXYZ).
RUN test -x "${CUDA_HOME}/bin/nvcc"

ENV _PIP_CACHE_DIR="/root/.cache/pip"

RUN --mount=type=cache,target=${_PIP_CACHE_DIR} \
    pip install --upgrade pip

# Mirrors pyproject.toml exactly. --no-build-isolation installs below must have
# every build dependency available before CMake configuration, including when
# outbound access is disabled.
RUN --mount=type=cache,target=${_PIP_CACHE_DIR} \
    pip install nanobind==2.10.2

ENV PROJECT_WORKDIR=/workspace/bionemo-ir
WORKDIR ${PROJECT_WORKDIR}
COPY requirements.txt ./
RUN --mount=type=cache,target=${_PIP_CACHE_DIR} \
    pip install -r requirements.txt

# ------------------------------------------------------------------------
# CI stage: runtime deps + test deps, no source
#   - build:extension and the test shards run on this and install the checkout
#     with --no-deps, so everything the suite imports must be here.
#   - deliberately outside the prod/dev chain below: prod_stage must not ship
#     pytest and friends.
# -------------------------------------------------------------------------
FROM requirements_stage AS ci_stage
ENV BIOIR_CUBIN_COMPILE_ENVIRONMENT=sha256:222d8b18e671be5c3ef91cb41727a2572a0b23f59ded6c39f373a96946f6f2ba
# The protected rolling-CUBIN job uses this already-built, commit-scoped image.
# Install its Git transport here, before the credential-bearing job starts,
# rather than running apt maintainer scripts with the bot token present.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git git-lfs \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-dev.txt ./
RUN --mount=type=cache,target=${_PIP_CACHE_DIR} \
    pip install -r requirements-dev.txt

# ------------------------------------------------------------------------
# copy source
#   - kept after the cuda-deps install so source edits don't invalidate it
# -------------------------------------------------------------------------
FROM requirements_stage AS copy_source_stage
COPY . ${PROJECT_WORKDIR}/

# ------------------------------------------------------
# install bionemo-ir for prod
# -----------------------------------------------------
FROM copy_source_stage AS prod_stage

# no-deps because we already installed requirements.txt in the requirements_stage
RUN --mount=type=cache,target=${_PIP_CACHE_DIR} \
    pip install --no-build-isolation --no-deps -v .

# ------------------------------------------------------------------------
# install bionemo-ir for development and testing
# -------------------------------------------------------------------------
FROM copy_source_stage AS dev_stage

RUN --mount=type=cache,target=${_PIP_CACHE_DIR} \
    pip install --no-build-isolation -v -e .[dev]
